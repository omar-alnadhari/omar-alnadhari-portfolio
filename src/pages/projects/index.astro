
---
import { getCollection } from 'astro:content';

import Layout from '../../layouts/Layout.astro';
import Navbar from '../../components/Navbar.astro';
import ProjectCard from '../../components/ProjectCard.astro';
import Footer from '../../components/Footer.astro';

const allProjects = (await getCollection('projects')).sort(
	(a, b) => a.data.order - b.data.order
);

const coreProjects = allProjects.filter(
	(project) => project.data.group === 'core'
);

const codvedaProjects = allProjects.filter(
	(project) => project.data.group === 'codveda'
);

const levels = [
	{ value: 'beginner', label: 'Level 1 — Beginner' },
	{ value: 'intermediate', label: 'Level 2 — Intermediate' },
	{ value: 'advanced', label: 'Level 3 — Advanced' },
].filter((level) =>
	codvedaProjects.some((project) => project.data.level === level.value)
);

const toCardProps = (project: (typeof allProjects)[number]) => ({
	title: project.data.title,
	category: project.data.category,
	description: project.data.summary,
	technologies: project.data.technologies,
	href: `/projects/${project.id}`,
	image: project.data.image,
});
---

<Layout
	title="Projects | Eng. Omar Yahya Al-Nadhari"
	description="Explore software engineering, backend systems, distributed computing, data science, and machine learning projects by Eng. Omar Yahya Al-Nadhari."
>
	<Navbar />

	<main id="main-content">
		<div class="mx-auto max-w-6xl px-6 py-24">

			<header class="max-w-3xl">
				<p class="text-sm font-medium uppercase tracking-[0.25em] text-slate-500 dark:text-slate-400">
					Projects
				</p>

				<h1 class="mt-3 text-4xl font-bold tracking-tight text-slate-950 dark:text-white sm:text-5xl">
					Engineering work across software, systems, AI, and data.
				</h1>

				<p class="mt-6 max-w-2xl leading-7 text-slate-600 dark:text-slate-300">
					A collection of practical software engineering, backend,
					full-stack, distributed computing, data science, and
					machine learning projects.
				</p>
			</header>

			<!-- Core Software Engineering Projects -->
			<section
				aria-labelledby="core-projects-heading"
				class="mt-16"
			>
				<div class="max-w-3xl">
					<p class="text-sm font-medium uppercase tracking-[0.25em] text-slate-500 dark:text-slate-400">
						Core Projects
					</p>

					<h2
						id="core-projects-heading"
						class="mt-3 text-2xl font-bold tracking-tight text-slate-950 dark:text-white sm:text-3xl"
					>
						Software Engineering & Systems
					</h2>

					<p class="mt-4 text-slate-600 dark:text-slate-300">
						Selected work across backend engineering, full-stack
						applications, distributed systems, and data platforms.
					</p>
				</div>

				<div class="mt-10 grid gap-8 md:grid-cols-2">
					{coreProjects.map((project) => (
						<ProjectCard {...toCardProps(project)} />
					))}
				</div>
			</section>

			<!-- Codveda Internship Projects -->
			{codvedaProjects.length > 0 && (
				<section
					aria-labelledby="codveda-projects-heading"
					class="mt-24 border-t border-slate-200 pt-16 dark:border-white/10"
				>
					<div class="max-w-3xl">
						<p class="text-sm font-medium uppercase tracking-[0.25em] text-slate-500 dark:text-slate-400">
							Data Science & Machine Learning
						</p>

						<h2
							id="codveda-projects-heading"
							class="mt-3 text-2xl font-bold tracking-tight text-slate-950 dark:text-white sm:text-3xl"
						>
							Codveda Technologies — Internship Projects
						</h2>

						<p class="mt-4 leading-7 text-slate-600 dark:text-slate-300">
							Nine practical data science and machine learning
							projects organized into beginner, intermediate,
							and advanced levels.
						</p>
					</div>

					{levels.map((level) => (
						<div class="mt-12">
							<h3 class="mb-6 text-xl font-semibold text-slate-950 dark:text-white">
								{level.label}
							</h3>

							<div class="grid gap-8 md:grid-cols-2">
								{codvedaProjects
									.filter(
										(project) =>
											project.data.level === level.value
									)
									.map((project) => (
										<ProjectCard {...toCardProps(project)} />
									))}
							</div>
						</div>
					))}
				</section>
			)}

		</div>
	</main>

	<Footer />
</Layout>
