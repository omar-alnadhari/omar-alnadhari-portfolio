---
import { getCollection } from 'astro:content';

import Layout from '../../layouts/Layout.astro';
import Navbar from '../../components/Navbar.astro';
import ProjectCard from '../../components/ProjectCard.astro';
import Footer from '../../components/Footer.astro';

const projects = (await getCollection('projects'))
	.sort((a, b) => a.data.order - b.data.order)
	.map((project) => ({
		title: project.data.title,
		category: project.data.category,
		description: project.data.summary,
		technologies: project.data.technologies,
		href: `/projects/${project.id}`,
		image: project.data.image,
	}));
---

<Layout
	title="Projects | Eng. Omar Al-Nadhari"
	description="Software engineering, backend, distributed systems, AI, and data projects by Eng. Omar Al-Nadhari."
>
	<Navbar />

	<main id="main-content">
		<section class="mx-auto max-w-6xl px-6 py-24">
			<div class="max-w-3xl">
				<p
					class="text-sm font-medium uppercase tracking-[0.25em] text-slate-500 dark:text-slate-400"
				>
					Projects
				</p>

				<h1
					class="mt-3 text-4xl font-bold tracking-tight text-slate-950 dark:text-white sm:text-5xl"
				>
					Engineering work across software, systems, AI, and data.
				</h1>

				<p class="mt-6 max-w-2xl leading-7 text-slate-600 dark:text-slate-300">
					A collection of projects demonstrating software engineering,
					backend development, full-stack systems, parallel and distributed
					computing, artificial intelligence, and data-driven applications.
				</p>
			</div>

			<div class="mt-14 grid gap-8 md:grid-cols-2">
				{projects.map((project) => (
					<ProjectCard {...project} />
				))}
			</div>
		</section>
	</main>

	<Footer />
</Layout>