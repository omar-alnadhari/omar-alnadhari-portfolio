---
import { getCollection, render } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import Navbar from '../../components/Navbar.astro';

export async function getStaticPaths() {
	const projects = await getCollection('projects');

	return projects.map((project) => ({
		params: { id: project.id },
		props: { project },
	}));
}

const { project } = Astro.props;
const { Content } = await render(project);
---

<Layout
	title={`${project.data.title} | Eng. Omar Al-Nadhari`}
	description={project.data.summary}
>
	<Navbar />

	<main id="main-content" class="mx-auto max-w-5xl px-6 py-20 sm:py-28">
		<a
			href="/projects"
			class="text-sm text-slate-600 transition hover:text-slate-950 dark:text-slate-400 dark:hover:text-white"
		>
			← Back to Projects
		</a>

		<header class="mt-10 border-b border-slate-200 pb-12 dark:border-white/10">
			<p class="text-sm font-medium uppercase tracking-[0.25em] text-slate-500 dark:text-slate-400">
				{project.data.category}
			</p>

			<h1 class="mt-4 max-w-4xl text-4xl font-bold tracking-tight text-slate-950 dark:text-white sm:text-5xl lg:text-6xl">
				{project.data.title}
			</h1>

			<p class="mt-6 max-w-3xl text-lg leading-8 text-slate-700 dark:text-slate-300">
				{project.data.summary}
			</p>

			<ul class="mt-8 flex flex-wrap gap-2">
				{project.data.technologies.map((technology) => (
					<li class="rounded-full border border-slate-200 bg-slate-50 px-3 py-1 text-sm text-slate-600 dark:border-white/10 dark:bg-white/[0.03] dark:text-slate-300">
						{technology}
					</li>
				))}
			</ul>
		</header>

		{project.data.image && (
			<figure class="mt-12 overflow-hidden rounded-2xl border border-slate-200 bg-white shadow-xl shadow-slate-200/40 dark:border-white/10 dark:bg-white/[0.03] dark:shadow-2xl dark:shadow-black/20">
				<img
					src={project.data.image}
					alt={`${project.data.title} project overview`}
					class="block w-full object-cover"
					loading="eager"
				/>
			</figure>
		)}

		<article
			class="
				prose prose-slate
				mt-14 max-w-none
				dark:prose-invert

				prose-headings:font-semibold
				prose-headings:tracking-tight
				prose-headings:text-slate-950
				dark:prose-headings:text-white

				prose-h2:mt-16
				prose-h2:border-t
				prose-h2:border-slate-200
				prose-h2:pt-10
				prose-h2:text-3xl
				dark:prose-h2:border-white/10

				prose-h3:mt-10
				prose-h3:text-xl

				prose-p:leading-8
				prose-p:text-slate-700
				dark:prose-p:text-slate-300

				prose-li:my-2
				prose-li:text-slate-700
				dark:prose-li:text-slate-300

				prose-strong:text-slate-950
				dark:prose-strong:text-white

				prose-code:rounded
				prose-code:bg-slate-100
				prose-code:px-1.5
				prose-code:py-0.5
				prose-code:text-slate-800
				prose-code:before:content-none
				prose-code:after:content-none
				dark:prose-code:bg-white/10
				dark:prose-code:text-slate-200

				prose-blockquote:border-slate-300
				prose-blockquote:text-slate-600
				dark:prose-blockquote:border-slate-600
				dark:prose-blockquote:text-slate-300

				prose-img:my-10
				prose-img:w-full
				prose-img:rounded-2xl
				prose-img:border
				prose-img:border-slate-200
				dark:prose-img:border-white/10

				prose-a:text-slate-950
				prose-a:decoration-slate-400
				hover:prose-a:decoration-slate-950
				dark:prose-a:text-white
				dark:prose-a:decoration-slate-500
				dark:hover:prose-a:decoration-white
			"
		>
			<Content />
		</article>
	</main>
</Layout>

<script>
	document.querySelectorAll('article a[href^="http"]').forEach((link) => {
		link.setAttribute('target', '_blank');
		link.setAttribute('rel', 'noopener noreferrer');
	});
</script>

<style is:global>
	article a[href*="github.com"] {
		display: inline-flex;
		align-items: center;
		gap: 0.5rem;
		margin-top: 0.5rem;
		padding: 0.7rem 1.1rem;

		border: 1px solid rgb(203 213 225);
		border-radius: 0.75rem;

		background: rgb(248 250 252);
		color: rgb(15 23 42);

		font-weight: 600;
		text-decoration: none;

		transition:
			background-color 0.2s ease,
			border-color 0.2s ease,
			transform 0.2s ease;
	}

	article a[href*="github.com"]:hover {
		background: rgb(241 245 249);
		border-color: rgb(148 163 184);
		transform: translateY(-2px);
	}

	html.dark article a[href*="github.com"] {
		border-color: rgba(255, 255, 255, 0.16);
		background: rgba(255, 255, 255, 0.05);
		color: white;
	}

	html.dark article a[href*="github.com"]:hover {
		background: rgba(255, 255, 255, 0.1);
		border-color: rgba(255, 255, 255, 0.3);
	}

	article a[href*="github.com"]::after {
		content: "↗︎";
		margin-left: 0.4rem;
		font-family: Arial, sans-serif;
		font-size: 0.9em;
	}

	article .github-coming-soon {
	display: inline-flex;
	align-items: center;
	gap: 0.5rem;
	margin-top: 0.5rem;
	padding: 0.7rem 1.1rem;

	border: 1px solid rgb(203 213 225);
	border-radius: 0.75rem;

	background: rgb(248 250 252);
	color: rgb(100 116 139);

	font-weight: 600;
	cursor: not-allowed;
	opacity: 0.75;
	}

	html.dark article .github-coming-soon {
		border-color: rgba(255, 255, 255, 0.16);
		background: rgba(255, 255, 255, 0.05);
		color: rgb(148 163 184);
	}
	
</style>