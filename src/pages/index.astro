---
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/Navbar.astro';
import Hero from '../components/Hero.astro';
import ProjectCard from '../components/ProjectCard.astro';
import { getCollection } from 'astro:content';
import About from '../components/About.astro';
import Skills from '../components/Skills.astro';
import Experience from '../components/Experience.astro';
import Education from '../components/Education.astro';
import Contact from '../components/Contact.astro';
import Footer from '../components/Footer.astro';
import Languages from '../components/Languages.astro';


const projects = (await getCollection('projects'))
	.filter((project) => project.data.featured)
	.sort((a, b) => a.data.order - b.data.order)
	.map((project) => ({
		title: project.data.title,
		category: project.data.category,
		description: project.data.summary,
		technologies: project.data.technologies,
		href: `/projects/${project.id}`,
		image: project.data.image,
	}));
---

<Layout
	title="Eng. Omar Al-Nadhari | Software Engineer"
	description="Portfolio of Omar Al-Nadhari, Software Engineer focused on backend systems, AI/data-driven applications, and scalable software."
>
	<Navbar />

	<main id="main-content">
		<Hero />

		<section id="projects" class="mx-auto max-w-6xl px-6 py-24">
			<div class="max-w-3xl">
				<p class="text-sm font-medium uppercase tracking-[0.25em] text-slate-500 dark:text-slate-400">
					Selected Work
				</p>

				<h2 class="mt-3 text-3xl font-bold tracking-tight text-slate-950 dark:text-white sm:text-4xl">
					Engineering projects across software, systems, and data.
				</h2>

				<p class="mt-5 max-w-2xl leading-7 text-slate-600 dark:text-slate-300">
					A selection of projects demonstrating backend development,
					full-stack engineering, parallel and distributed computing,
					and reproducible data-driven systems.
				</p>
			</div>

			<div class="mt-12 grid gap-8 md:grid-cols-2">
				{projects.map((project) => (
					<ProjectCard {...project} />
				))}
			</div>

			<div class="mt-12 flex justify-center">
				<a
					href="/projects"
					class="inline-flex items-center gap-2 rounded-lg border border-slate-300 px-6 py-3 text-sm font-semibold text-slate-900 transition hover:border-slate-400 hover:bg-slate-100 dark:border-white/20 dark:text-white dark:hover:border-white/40 dark:hover:bg-white/5"
				>
					View All Projects
					<span aria-hidden="true">→</span>
				</a>
			</div>

		</section>

		<About />

		<Skills />

		<Experience />

		<Education />
		
		<Languages />

		<Contact />
		
	</main>

	<Footer />

</Layout>