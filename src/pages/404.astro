---
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/Navbar.astro';
---

<Layout
	title="Page Not Found | Omar Al-Nadhari"
	description="The requested page could not be found."
>
	<Navbar />

	<main id="main-content" class="mx-auto flex min-h-[75vh] max-w-6xl items-center px-6 py-24">
		<div class="max-w-2xl">
			<p class="text-sm font-medium uppercase tracking-[0.25em] text-slate-400">
				Error 404
			</p>

			<h1 class="mt-4 text-5xl font-bold tracking-tight text-white sm:text-6xl">
				Page not found.
			</h1>

			<p class="mt-6 text-lg leading-8 text-slate-300">
				The page you're looking for doesn't exist or may have been moved.
			</p>

			<a
				href="/"
				class="mt-8 inline-flex rounded-lg bg-white px-6 py-3 text-sm font-semibold text-slate-950 transition hover:bg-slate-200"
			>
				Back to Home
			</a>
		</div>
	</main>
</Layout>