---
const experiences = [
	{
		role: 'Lecturer – Programming and Software Engineering',
		organization: 'Faculty of Engineering, Taiz University',
		period: 'August 2024 – May 2025',
		description: [
			'Entrusted with full responsibility for planning and delivering an undergraduate programming course, including theoretical lectures, practical laboratory sessions, assignments, assessments, and student support.',
			'Designed programming exercises and software projects and reviewed student code for logical, syntactic, runtime, implementation, and design errors.',
			'Evaluated student code, software projects, technical documentation, use cases, and system-design diagrams for correctness, completeness, consistency, and adherence to requirements.',
			'Provided detailed, evidence-based written and verbal feedback while maintaining consistent assessment standards across student submissions.',
			'Authored a complete course book containing structured explanations, worked examples, and programming exercises.',
		],
	},
	{
		role: 'Research Mentor',
		organization: 'Taiz University',
		period: 'August 2023 – Present',
		description: [
			'Guide undergraduate students in research design, methodology, data analysis, interpretation of results, and technical and academic documentation.',
			'Review research and graduation-project artifacts, including requirements, use cases, software-analysis diagrams, methodologies, and analytical conclusions for correctness, consistency, and completeness.',
		],
	},
	{
		role: 'IT Support and Data Analysis Assistant',
		organization: 'AlKuraimi Islamic Bank',
		period: 'January 2025 – May 2025',
		description: [
			'Provided technical support to bank employees, diagnosing and resolving operating-system, application, user-account, permission, printer, and basic network issues.',
			'Installed and configured Windows systems, Microsoft applications, and banking software while coordinating incidents with central IT and networking teams.',
			'Collected, cleaned, validated, and organized operational data used in internal analysis and reporting, identifying recurring issues and patterns.',
			'Supported business requirements analysis for an internal banking workflow, including process flowcharts and functional and non-functional requirements.',
		],
	},
];
---


<section id="experience" class="mx-auto max-w-6xl px-6 py-28">
	<div class="max-w-3xl">
		<p class="text-sm font-medium uppercase tracking-[0.25em] text-slate-500 dark:text-slate-400">
			Experience
		</p>

		<h2 class="mt-4 text-3xl font-bold tracking-tight text-slate-950 dark:text-white sm:text-4xl">
			Professional experience and technical responsibility.
		</h2>

		<p class="mt-5 max-w-2xl leading-7 text-slate-600 dark:text-slate-400">
			Experience across software education, research mentoring,
			banking technology, technical support, and data analysis.
		</p>
	</div>

	<div class="mt-14 space-y-6">
		{experiences.map((experience) => (
			<article
				class="grid gap-6 rounded-2xl border border-slate-200 bg-white p-7 shadow-sm transition hover:-translate-y-0.5 hover:border-slate-300 hover:shadow-md dark:border-white/10 dark:bg-white/[0.03] dark:shadow-none dark:hover:border-white/20 md:grid-cols-[0.35fr_0.65fr] md:p-8"
			>
				<div>
					<h3 class="text-xl font-semibold text-slate-950 dark:text-white">
						{experience.role}
					</h3>

					<p class="mt-2 text-slate-700 dark:text-slate-300">
						{experience.organization}
					</p>

					<p class="mt-3 text-sm text-slate-500">
						{experience.period}
					</p>
				</div>

				<ul class="space-y-3 leading-7 text-slate-700 dark:text-slate-300">
					{experience.description.map((item) => (
						<li class="flex gap-3">
							<span
								class="mt-3 h-1.5 w-1.5 shrink-0 rounded-full bg-slate-400 dark:bg-slate-500"
							></span>

							<span>{item}</span>
						</li>
					))}
				</ul>
			</article>
		))}
	</div>
</section>