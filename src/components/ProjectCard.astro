---
interface Props {
	title: string;
	category: string;
	description: string;
	technologies: string[];
	href: string;
	image?: string;
}

const {
	title,
	category,
	description,
	technologies,
	href,
	image,
} = Astro.props;
---

<article
	class="group flex h-full flex-col overflow-hidden rounded-2xl border border-slate-200 bg-white transition duration-300 hover:-translate-y-1 hover:border-slate-300 hover:shadow-lg dark:border-white/10 dark:bg-white/[0.03] dark:hover:border-white/20 dark:hover:bg-white/[0.05]"
>
	{image ? (
		<div class="aspect-[16/9] overflow-hidden border-b border-slate-200 bg-slate-100 dark:border-white/10 dark:bg-slate-900">
			<img
				src={image}
				alt={`${title} project preview`}
				class="h-full w-full object-cover transition duration-500 group-hover:scale-[1.02]"
				loading="lazy"
			/>
		</div>
	) : (
		<div
			class="flex aspect-[16/9] items-center justify-center border-b border-slate-200 bg-gradient-to-br from-slate-100 to-slate-200 dark:border-white/10 dark:from-slate-900 dark:to-slate-800"
		>
			<span class="text-sm font-medium uppercase tracking-[0.25em] text-slate-500">
				Project Preview
			</span>
		</div>
	)}

	<div class="flex flex-1 flex-col p-7">
		<p class="text-sm font-medium uppercase tracking-[0.2em] text-slate-500 dark:text-slate-400">
			{category}
		</p>

		<h3 class="mt-4 text-2xl font-semibold tracking-tight text-slate-950 dark:text-white">
			{title}
		</h3>

		<p class="mt-4 flex-1 leading-7 text-slate-600 dark:text-slate-300">
			{description}
		</p>

		<ul class="mt-6 flex flex-wrap gap-2">
			{technologies.slice(0, 6).map((technology) => (
				<li
					class="rounded-full border border-slate-200 bg-slate-50 px-3 py-1 text-sm text-slate-600 dark:border-white/10 dark:bg-white/[0.03] dark:text-slate-300"
				>
					{technology}
				</li>
			))}
		</ul>

		<a
			href={href}
			class="mt-8 inline-flex items-center gap-2 text-sm font-semibold text-slate-900 transition group-hover:gap-3 dark:text-white"
		>
			View Case Study
			<span aria-hidden="true">→</span>
		</a>
	</div>
</article>