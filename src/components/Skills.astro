---
const skillGroups = [
	{
		title: 'Programming Languages',
		skills: [
			'Python',
			'C++',
			'C',
			'C#',
			'JavaScript',
			'TypeScript',
			'PHP',
			'SQL',
			'Java',
		],
	},
	{
		title: 'Backend & Web',
		skills: [
			'FastAPI',
			'REST APIs',
			'Node.js',
			'Laravel',
			'React',
			'HTML/CSS',
			'API Integration',
		],
	},
	{
		title: 'Databases',
		skills: [
			'MySQL',
			'SQLite',
			'PostgreSQL',
			'Relational Databases',
			'CTEs',
			'Window Functions',
		],
	},
	{
		title: 'Software Engineering',
		skills: [
			'OOP',
			'Data Structures',
			'Algorithms',
			'Automated Testing',
			'Pytest',
			'Debugging',
			'Code Review',
			'API Design',
		],
	},
	{
		title: 'DevOps & Tools',
		skills: [
			'Git',
			'GitHub',
			'Docker',
			'GitHub Actions',
			'CI/CD',
			'Linux',
			'Bash',
		],
	},
	{
		title: 'AI & Data',
		skills: [
			'Machine Learning',
			'Pandas',
			'NumPy',
			'scikit-learn',
			'SciPy',
			'statsmodels',
			'Jupyter',
		],
	},
	{
		title: 'Parallel & Distributed Computing',
		skills: [
			'OpenMP',
			'MPI',
			'AVX2',
			'Multithreading',
			'GCC',
			'Makefiles',
			'SLURM',
		],
	},
];
---

<section id="skills" class="mx-auto max-w-6xl px-6 py-24">
	<div class="max-w-2xl">
		<p class="text-sm font-medium uppercase tracking-[0.25em] text-slate-500 dark:text-slate-400">
			Technical Skills
		</p>

		<h2 class="mt-3 text-3xl font-bold tracking-tight text-slate-950 dark:text-white sm:text-4xl">
			Tools I use to build software.
		</h2>

		<p class="mt-4 leading-7 text-slate-600 dark:text-slate-300">
			Technologies and engineering practices used across my software,
			systems, web, AI, and data projects.
		</p>
	</div>

	<div class="mt-12 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
		{skillGroups.map((group) => (
			<div class="rounded-2xl border border-slate-200 bg-white p-6 shadow-sm transition hover:-translate-y-0.5 hover:border-slate-300 hover:shadow-md dark:border-white/10 dark:bg-white/[0.03] dark:shadow-none dark:hover:border-white/20 dark:hover:bg-white/[0.05]">
				<h3 class="text-lg font-semibold text-slate-950 dark:text-white">
					{group.title}
				</h3>

				<ul class="mt-5 flex flex-wrap gap-2">
					{group.skills.map((skill) => (
						<li
							class="rounded-full border border-slate-200 bg-slate-50 px-3 py-1.5 text-sm text-slate-600 dark:border-white/10 dark:bg-white/[0.03] dark:text-slate-300"
						>
							{skill}
						</li>
					))}
				</ul>
			</div>
		))}
	</div>
</section>